{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "public",
  "functions": {
    "api/chapter.js": {
      "includeFiles": "private/course/**"
    },
    "api/file.js": {
      "includeFiles": "private/files/**"
    }
  },
  "redirects": [
    {
      "source": "/ideas",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/ideas/:path*",
      "destination": "/guides/best-3d-prints-to-sell",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/tools/3d-print-price-calculator",
      "permanent": false
    },
    {
      "source": "/calculator",
      "destination": "/tools/3d-print-price-calculator",
      "permanent": true
    },
    {
      "source": "/removal",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/guides/side-hustle-playbook",
      "destination": "/guides/print-to-profit",
      "permanent": true
    },
    {
      "source": "/guides/design-your-own-bestseller",
      "destination": "/guides/print-to-profit",
      "permanent": false
    },
    {
      "source": "/plans",
      "destination": "/plan",
      "permanent": false
    },
    {
      "source": "/free",
      "destination": "/plan",
      "permanent": false
    },
    {
      "source": "/freeplan",
      "destination": "/plan",
      "permanent": false
    },
    {
      "source": "/free-plan",
      "destination": "/plan",
      "permanent": false
    },
    {
      "source": "/7-day-plan",
      "destination": "/plan",
      "permanent": false
    },
    {
      "source": "/guide",
      "destination": "/guides/print-to-profit",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/guides/print-to-profit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://rcntkzrbanwigypkumvd.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}